DJANGO_SECRET_KEY=replace-with-a-development-only-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=amootech
POSTGRES_USER=amootech
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOCAL_UID=1000
LOCAL_GID=1000
ALLOW_DEMO_SEED=true
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_SERVICE_TOKEN=
TELEGRAM_BOT_CONTROL_BASE_URL=
TELEGRAM_BOT_CONTROL_TOKEN=
# Next.js public API base: NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
QUIZ24_BASE_URL=https://www.quiz24.ir/api/v1/
QUIZ24_API_KEY=
FRONTEND_BASE_URL=http://localhost:3000
QUIZ24_CALLBACK_URL=
QUIZ24_STUDENT_CALLBACK_URL=
QUIZ24_USER_ID=

# Student mobile verification: no SMS sender is enabled by default.
# Production: dotted path to a configured SMS adapter implementing send(...).
STUDENT_OTP_BACKEND=
# Local development only; requires DJANGO_DEBUG=true as well.
STUDENT_OTP_DEV_ENABLED=false
# Private container directory, never served over HTTP or written to logs.
STUDENT_OTP_DEV_OUTBOX=/tmp/amootech-mobile-otp

# Optional, individually confirmed deletion of eligible Quiz24 exams.
QUIZ24_REMOTE_DELETE_ENABLED=false
